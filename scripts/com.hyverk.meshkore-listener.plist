<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hyverk.meshkore-listener</string>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_ABSOLUTE_PATH_TO_HIVERK_REPO</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>scripts/meshkore-listener.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/meshkore-listener.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/meshkore-listener.stderr.log</string>
</dict>
</plist>
